# =============================================================================
# Backend de dropshipping — variables de entorno (copie a .env y complete)
# NUNCA versione el archivo .env: contiene secretos.
# =============================================================================

# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
# 127.0.0.1 = solo accesible desde este equipo. n8n (Docker Desktop) llega vía host.docker.internal.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# --- Fase 1: evaluación sin estado (POST /api/v1/products/evaluate con { product }) ---
DEFAULT_TARGET_MARGIN_PERCENT=30
DEFAULT_MAX_DELIVERY_DAYS=7
DEFAULT_REQUIRED_ORIGIN_COUNTRY=US

# --- Seguridad (Fase 2) -----------------------------------------------------
# Genere valores aleatorios de 32+ caracteres, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_API_KEY: automatizaciones (n8n): importar, evaluar, preparar/crear borradores.
ADMIN_API_KEY=
# APPROVER_API_KEY: SOLO para decisiones humanas (aprobar/rechazar). No la cargue en n8n.
APPROVER_API_KEY=

# --- Persistencia -----------------------------------------------------------
# Contraseña del contenedor PostgreSQL local (docker-compose.yml). Solo escucha en 127.0.0.1:5433.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Sin DATABASE_URL se usa persistencia EN MEMORIA (se pierde al reiniciar).
DATABASE_URL=postgres://dropship:<POSTGRES_PASSWORD>@127.0.0.1:5433/dropship
DB_AUTO_MIGRATE=true
# Solo para `npm run test:postgres` (base dedicada que las pruebas vacían).
TEST_DATABASE_URL=postgres://dropship:<POSTGRES_PASSWORD>@127.0.0.1:5433/dropship_test
# Reglas de evaluación (márgenes, comisiones, CAC, categorías...). Editables sin tocar código.
RULES_FILE=config/evaluation-rules.json

# --- Proveedores -------------------------------------------------------------
# Proveedor ficticio para desarrollo y demostración.
MOCK_SUPPLIER_ENABLED=true
# CJdropshipping (requiere cuenta y API key: ver docs/credenciales.md)
CJ_ENABLED=false
CJ_API_KEY=
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
# 1 req/s es el límite documentado para cuentas gratuitas.
CJ_MAX_REQUESTS_PER_SECOND=1
CJ_TIMEOUT_MS=15000
CJ_MAX_QUOTED_VARIANTS=5

# --- Tienda (Shopify) ---------------------------------------------------------
# disabled = sin tienda | mock = tienda simulada en memoria | live = Shopify real
SHOPIFY_MODE=mock
# Solo con SHOPIFY_MODE=live:
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-10
# Opción A (apps del Dev Dashboard, misma organización): client credentials (token de 24 h)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Opción B (app personalizada "legacy" ya existente): token de Admin API
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Interruptor explícito de escritura. Aun en true, solo se crean BORRADORES aprobados.
SHOPIFY_WRITE_ENABLED=false
SHOPIFY_TIMEOUT_MS=20000
# Proveedor (vendor) que se mostrará en Shopify; vacío = no se envía.
STORE_VENDOR_NAME=
# Fase 3: desactivada por defecto; requiere PostgreSQL y migracion 0002.
COMMERCE_ENABLED=false
SHOPIFY_WEBHOOK_SECRET=
# 32 bytes aleatorios expresados como 64 caracteres hexadecimales. Respaldar fuera del repo.
COMMERCE_ENCRYPTION_KEY=
